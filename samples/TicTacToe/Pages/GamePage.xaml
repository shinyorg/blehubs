<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TicTacToe.Pages"
             x:Class="TicTacToe.Pages.GamePage"
             x:DataType="local:GameViewModel"
             Title="{Binding Role}">

    <!-- the bottom edge pads for the keyboard so the chat entry stays visible -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
          Padding="16"
          RowSpacing="16"
          SafeAreaEdges="Container, Container, Container, SoftInput">

        <!-- players -->
        <Grid ColumnDefinitions="*,Auto,*">
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border Style="{StaticResource AvatarBorder}"
                        Stroke="{StaticResource XColor}"
                        StrokeThickness="{Binding IsXTurn, Converter={StaticResource TurnStrokeConverter}}">
                    <Grid>
                        <Label Text="X" Style="{StaticResource AvatarFallback}" TextColor="{StaticResource XColor}" />
                        <Image Source="{Binding XAvatar}" Aspect="AspectFill" />
                    </Grid>
                </Border>
                <Label Text="{Binding XName}" HorizontalOptions="Center" FontAttributes="Bold" />
            </VerticalStackLayout>

            <Label Grid.Column="1"
                   Text="{Binding Score}"
                   VerticalOptions="Center"
                   FontSize="16" />

            <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                <Border Style="{StaticResource AvatarBorder}"
                        Stroke="{StaticResource OColor}"
                        StrokeThickness="{Binding IsOTurn, Converter={StaticResource TurnStrokeConverter}}">
                    <Grid>
                        <Label Text="O" Style="{StaticResource AvatarFallback}" TextColor="{StaticResource OColor}" />
                        <Image Source="{Binding OAvatar}" Aspect="AspectFill" />
                    </Grid>
                </Border>
                <Label Text="{Binding OName}" HorizontalOptions="Center" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>

        <Label Grid.Row="1"
               Text="{Binding Status}"
               FontSize="22"
               HorizontalOptions="Center" />

        <!-- board -->
        <Grid Grid.Row="2"
              x:Name="Board"
              RowDefinitions="*,*,*"
              ColumnDefinitions="*,*,*"
              RowSpacing="8"
              ColumnSpacing="8"
              VerticalOptions="Center"
              BindableLayout.ItemsSource="{Binding Cells}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="local:CellViewModel">
                    <Button Grid.Row="{Binding Row}"
                            Grid.Column="{Binding Column}"
                            Text="{Binding Text}"
                            Style="{StaticResource CellButton}"
                            BackgroundColor="{Binding IsWinning, Converter={StaticResource WinningCellConverter}}"
                            TextColor="{Binding Text, Converter={StaticResource MarkColorConverter}}"
                            Command="{Binding PlayCommand, Source={RelativeSource AncestorType={x:Type local:GameViewModel}}, x:DataType=local:GameViewModel}"
                            CommandParameter="{Binding .}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </Grid>

        <!-- emotes / toasts -->
        <Grid Grid.Row="3">
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="8"
                                   BindableLayout.ItemsSource="{Binding Emotes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}"
                                Style="{StaticResource EmoteButton}"
                                Command="{Binding SendEmoteCommand, Source={RelativeSource AncestorType={x:Type local:GameViewModel}}, x:DataType=local:GameViewModel}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Border IsVisible="{Binding Emote, Converter={StaticResource IsNotNullConverter}}"
                    Style="{StaticResource Toast}">
                <Label Text="{Binding Emote}" TextColor="White" HorizontalTextAlignment="Center" />
            </Border>
        </Grid>

        <!-- chat - covers the board and emotes while open -->
        <Grid Grid.Row="2"
              Grid.RowSpan="2"
              RowDefinitions="*,Auto"
              RowSpacing="8"
              IsVisible="{Binding IsChatOpen}"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
            <CollectionView ItemsSource="{Binding Chat}"
                            ItemsUpdatingScrollMode="KeepLastItemInView">
                <CollectionView.EmptyView>
                    <Label Text="No messages yet - say hi 👋"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ChatLineViewModel">
                        <Border Style="{StaticResource ChatBubble}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                    <Setter Property="HorizontalOptions" Value="End" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2">
                                <Label FontSize="12">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding From}" TextColor="{Binding NameColor}" FontAttributes="Bold" />
                                            <Span Text="  " />
                                            <Span Text="{Binding Time}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding Text}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Text="{Binding ChatText}"
                       Placeholder="Message"
                       MaxLength="{Binding MaxChatLength}"
                       ReturnType="Send"
                       ReturnCommand="{Binding SendChatCommand}" />
                <Button Grid.Column="1"
                        Text="Send"
                        Command="{Binding SendChatCommand}" />
            </Grid>
        </Grid>

        <VerticalStackLayout Grid.Row="4" Spacing="8">
            <Button Text="{Binding ChatButtonText}"
                    Command="{Binding ToggleChatCommand}"
                    Style="{StaticResource SecondaryButton}" />
            <Button Text="Rematch"
                    Command="{Binding RematchCommand}"
                    IsVisible="{Binding CanRematch}" />
            <Button Text="Remove spectators"
                    Command="{Binding KickSpectatorsCommand}"
                    Style="{StaticResource SecondaryButton}"
                    IsVisible="{Binding IsHost}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
