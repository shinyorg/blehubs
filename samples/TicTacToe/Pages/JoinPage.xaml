<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TicTacToe.Pages"
             x:Class="TicTacToe.Pages.JoinPage"
             x:DataType="local:JoinViewModel"
             Title="Join a game">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <HorizontalStackLayout Spacing="10">
            <ActivityIndicator IsRunning="True" HeightRequest="20" WidthRequest="20" />
            <Label Text="{Binding Status}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Hosts}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Ask a friend to tap 'Host a game'"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:HostItem">
                    <Border Margin="0,6" Padding="16" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="{Binding Rssi, StringFormat='{0} dBm'}"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConnectCommand, Source={RelativeSource AncestorType={x:Type local:JoinViewModel}}, x:DataType=local:JoinViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsConnecting}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsConnecting}" Color="White" />
        </Grid>
    </Grid>
</ContentPage>
